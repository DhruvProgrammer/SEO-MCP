WP_BASE_URL=
WP_USERNAME=
WP_APP_PASSWORD=
MONGO_URI=

# Optional overrides. The defaults match the live FlixGarden site.
# NOTE: the names below are exactly what config.py reads. GENRE_* are not
# WP_-prefixed; setting the WP_-prefixed spelling silently does nothing.
# WP_GENRE_TAXONOMY=genre
# WP_ACTOR_TAXONOMY=actor
# GENRE_FUZZY_THRESHOLD=0.78
# GENRE_CACHE_TTL=86400

# Poster download limits (config.py: MAX_IMAGE_BYTES / MAX_IMAGE_REDIRECTS).
# WP_MAX_IMAGE_BYTES=5242880
# WP_MAX_IMAGE_REDIRECTS=3

# Poster fetch controls.
# Poster hosts default to the host of WP_BASE_URL, because image_url comes off a
# scraped page and is therefore attacker-influenced. Widen only if posters are
# genuinely served from elsewhere, comma-separated:
# WP_POSTER_HOSTS=flixgarden.site,cdn.example.com
# Wall-clock ceiling for one poster download (requests' timeout= is per-read,
# so a slow-drip server would otherwise hold a worker indefinitely).
# WP_POSTER_DOWNLOAD_DEADLINE=30